    "Modified values will appear here for quick access and sharing.": {
      "comment": "An empty state description in the Tuning tab explaining that locally edited topics will be listed there.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر القيم المعدلة هنا للوصول السريع والمشاركة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
