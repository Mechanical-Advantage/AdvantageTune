          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores modificados aparecerán aquí para un acceso rápido y compartirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs modifiées apparaîtront ici pour un accès rapide et le partage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏ערכים ששונו יופיעו כאן לגישה מהירה ושיתוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "त्वरित पहुंच और साझाकरण के लिए संशोधित मान यहां दिखाई देंगे।"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгертілген мәндер жылдам қол жеткізу және бөлісу үшін осында пайда болады."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewijzigde waarden verschijnen hier voor snelle toegang en delen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores modificados aparecerão aqui para acesso rápido e compartilhamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorile modificate vor apărea aici pentru acces rapid și partajare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измененные значения появятся здесь для быстрого доступа и совместного использования."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
