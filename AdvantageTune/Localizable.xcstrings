    "Subfield edits are packed into binary format and published automatically.": {
      "comment": "A footer explanation in the struct editor indicating that field modifications are re-encoded into binary and published automatically.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحزم تعديلات الحقول الفرعية بتنسيق ثنائي وتُنشر تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subfield edits are packed into binary format and published automatically."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las modificaciones de subcampos se empaquetan en formato binario y se publican automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de sous-champs sont empaquetées au format binaire et publiées automatiquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏עריכות של שדות משנה נארזות בפורמט בינארי ומפורסמות באופן אוטומטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबफ़ील्ड संपादनों को बाइनरी प्रारूप में पैक किया जाता है और स्वचालित रूप से प्रकाशित किया जाता है।"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ішкі өріс өңдеулері екілік пішімде жинақталып, автоматты түрде жарияланады."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerkingen van subvelden worden verpakt in binair formaat en automatisch gepubliceerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As edições de subcampos são empacotadas em formato binário e publicadas automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editările subcâmpurilor sunt împachetate în format binar și publicate automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения подполей упаковываются в двоичный формат и публикуются автоматически."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt alan düzenlemeleri ikili biçimde paketlenir ve otomatik olarak yayınlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子字段的更改将打包为二进制格式并自动发布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "子欄位的變更將封裝為二進位格式並自動發布。"
          }
        }
      }
    },
