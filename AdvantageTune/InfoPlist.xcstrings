    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم AdvantageTune الشبكة المحلية للتواصل مع خوادم NetworkTables."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdvantageTune uses the local network to communicate with NetworkTables servers."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdvantageTune utiliza la red local para comunicarse con los servidores de NetworkTables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdvantageTune utilise le réseau local pour communiquer avec les serveurs NetworkTables."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏AdvantageTune משתמש ברשת המקומית כדי לתקשר עם שרתי NetworkTables."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdvantageTune, NetworkTables सर्वरों के साथ संचार करने के लिए स्थानीय नेटवर्क का उपयोग करता है।"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdvantageTune қолданбасы NetworkTables серверлерімен байланысу үшін жергілікті желіні пайдаланады."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdvantageTune gebruikt het lokale netwerk om te communiceren met NetworkTables-servers."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AdvantageTune usa a rede local para se comunicar com servidores NetworkTables."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdvantageTune folosește rețeaua locală pentru a comunica cu serverele NetworkTables."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdvantageTune использует локальную сеть для связи с серверами NetworkTables."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdvantageTune, NetworkTables sunucularıyla iletişim kurmak için yerel ağı kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdvantageTune 使用局域网与 NetworkTables 服务器通信。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdvantageTune 使用區域網路與 NetworkTables 伺服器進行通訊。"
          }
        }
      }
    }
  },
  "version" : "1.2"
